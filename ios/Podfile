platform :ios, '12.0'

# Point to your app root, then require Flutter's podhelper from the Flutter SDK
flutter_application_path = File.expand_path('..', __dir__)
require File.expand_path(File.join(flutter_application_path, 'packages', 'flutter_tools', 'bin', 'podhelper'))

# Set up Flutter iOS pods
flutter_ios_podfile_setup

target 'Runner' do
  # Static linking tends to play nicer with many pods
  use_frameworks! :linkage => :static
  use_modular_headers!

  # Install all Flutter plugin pods
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Your model needs Select TF Ops. Pin version to match TensorFlowLiteC/Swift 2.12.0
  pod 'TensorFlowLiteSelectTfOps', '2.12.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Harmonize simulator arch to avoid EXCLUDED_ARCHS warnings on Apple Silicon
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Apply Flutter's additional build settings (important!)
  flutter_additional_ios_build_settings(installer)
end
